def baixar_arquivo(url, caminho_saida):
    try:
        r = requests.get(url, headers=HEADERS, timeout=10)
        r.raise_for_status()
        with open(caminho_saida, 'wb') as f:
            f.write(r.content)
        print(f'Download concluído: {caminho_saida}')
    except requests.exceptions.RequestException as erro:
        print(f'Falha ao baixar o arquivo: {erro}')


baixar_arquivo('https://picsum.photos/400/400', '/mnt/user-data/outputs/imagem_aleatoria.jpg')


robots = requests.get('https://books.toscrape.com/robots.txt', headers=HEADERS, timeout=10)
print(robots.text)

pagina = requests.get('https://books.toscrape.com/', headers=HEADERS, timeout=10)
soup = BeautifulSoup(pagina.text, 'html.parser')

livros = soup.select('article.product_pod')[:5]

dados_livros = []
for livro in livros:
    titulo = livro.h3.a['title']
    preco = livro.select_one('p.price_color').text
    dados_livros.append({'titulo': titulo, 'preco': preco})

df_livros = pd.DataFrame(dados_livros)
df_livros.to_csv('/mnt/user-data/outputs/livros_scraping.csv', index=False)
print(df_livros)


